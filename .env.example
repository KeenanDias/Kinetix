# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
# Public URL of the deployed site (used for links inside emails)
NEXT_PUBLIC_SITE_URL=https://kinetix.example.com
NEXT_PUBLIC_TIMEZONE=America/Toronto
NEXT_PUBLIC_HOST_NAME=Harsh
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/kinetix
NEXT_PUBLIC_CONTACT_EMAIL=info.kinetixsports@gmail.com

# ---- Interac e-Transfer instructions shown to players ----
NEXT_PUBLIC_ETRANSFER_EMAIL=payments@kinetix.example.com
NEXT_PUBLIC_ETRANSFER_QUESTION=What is the business name?
NEXT_PUBLIC_ETRANSFER_ANSWER=kinetix

# ---- Email (Resend free tier: 3,000 emails/month) ----
RESEND_API_KEY=re_xxxxxxxx
# Must be on a domain you verified in Resend (or onboarding@resend.dev while testing)
EMAIL_FROM=Kinetix Volleyball <info@kinetixsports.ca>
# Who gets the "new registration - tap to approve" email. Comma-separated.
HOST_NOTIFY_EMAILS=harsh@example.com

# ---- One-tap approval links ----
# Long random string: `openssl rand -base64 48`
REVIEW_LINK_SECRET=change-me-to-a-long-random-string

# ---- Daily data cleanup (/api/cron/cleanup, called by .github/workflows/cleanup.yml) ----
# Long random string. Put the same value in the GitHub repo secret CRON_SECRET.
CRON_SECRET=change-me-to-another-long-random-string
